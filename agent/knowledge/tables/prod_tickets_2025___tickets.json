    {"name": "status__name", "type": "Nullable(String)", "description": "Current ticket status", "values": ["Closed", "Open", "Waiting for Customer", "Cancelled", "Onhold", "Assigned", "Waiting for Vendor", "Part Required", "In Progress", "Waiting for parts - NOC"]},
    {"name": "status__id", "type": "Nullable(String)", "description": "Status identifier"},
    {"name": "status__color", "type": "Nullable(String)", "description": "Status display color"},
    {"name": "priority__name", "type": "Nullable(String)", "description": "Ticket priority level", "values": ["P1", "P2", "P3", "P4"]},
    {"name": "priority__id", "type": "Nullable(String)", "description": "Priority identifier"},
    {"name": "priority__color", "type": "Nullable(String)", "description": "Priority display color"},
    {"name": "category__name", "type": "Nullable(String)", "description": "Ticket category", "values": ["Microsoft", "Reports", "End User Support", "Information Security", "Systems", "Network & Security", "Patch Management", "Application", "Telecom", "Preventive Maintenance"]},
    {"name": "category__id", "type": "Nullable(String)", "description": "Category identifier"},

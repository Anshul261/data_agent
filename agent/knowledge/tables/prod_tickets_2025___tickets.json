    {"name": "last_updated_time_ts", "type": "Nullable(DateTime64(6, 'UTC'))", "description": "Last modification timestamp"},
    {"name": "created_time__display_value", "type": "Nullable(String)", "description": "Human-readable created time"},
    {"name": "created_time__value", "type": "Nullable(String)", "description": "Created time as string value"},
    {"name": "due_by_time__display_value", "type": "Nullable(String)", "description": "Human-readable due time"},
    {"name": "due_by_time__value", "type": "Nullable(String)", "description": "Due time as string value"},
    {"name": "time_elapsed_ms", "type": "Nullable(Int64)", "description": "Time elapsed in milliseconds from creation to resolution"},

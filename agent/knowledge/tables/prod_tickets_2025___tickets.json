{
  "table_name": "prod_tickets_2025___tickets",
  "database": "prod_tickets_2025",
  "description": "Main IT support tickets table from ManageEngine ServiceDesk Plus. Contains all ticket data including requester info, technician assignments, priorities, statuses, SLA tracking, resolution details, and timestamps. This is the primary table for all ticket analytics.",
  "row_count_approx": 19374,
  "columns": [
